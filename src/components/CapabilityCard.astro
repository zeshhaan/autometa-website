---
import Icon from './Icon.astro';
import type { Capability } from '../data/site';

interface Props {
  capability: Capability;
  index?: number;
}
const { capability, index = 0 } = Astro.props;
---

<div
  class="reveal group relative flex flex-col gap-3 rounded-xl border border-border bg-card p-6 transition-[transform,border-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-border-strong card-highlight"
  style={`--reveal-delay: ${(index % 3) * 70}ms`}
>
  <div class="flex items-center gap-3">
    <span
      class="inline-flex size-10 items-center justify-center rounded-lg border border-border bg-card-muted text-foreground transition-colors group-hover:bg-accent-soft"
    >
      <Icon name={capability.icon} size={20} />
    </span>
    <span class="font-mono text-xs text-accent">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <h3 class="text-base font-medium tracking-tight text-foreground">{capability.name}</h3>
  <p class="text-sm leading-relaxed text-muted-foreground">{capability.description}</p>
  <ul class="mt-auto grid gap-1.5 pt-2">
    {capability.items.map((it) => (
      <li class="flex items-start gap-2 text-sm text-foreground/80">
        <Icon name="check" size={15} class="mt-0.5 shrink-0 text-success" />
        <span>{it}</span>
      </li>
    ))}
  </ul>
</div>
