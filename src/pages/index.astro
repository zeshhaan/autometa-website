---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Background from '../components/Background.astro';
import ShinyBadge from '../components/ShinyBadge.astro';
import SlotBadge from '../components/SlotBadge.astro';
import Button from '../components/Button.astro';
import BuildRow from '../components/BuildRow.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Integrations from '../components/Integrations.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { buildAreas, industries, capabilities, differentiators, site } from '../data/site';

const processSteps = [
  { step: '01', title: 'Discover', description: 'We get to the heart of the problem: who it is for, how the work happens today, and what the first version must get right.' },
  { step: '02', title: 'Design & build', description: 'You see working software in weeks, not months. We design and ship in increments so you can react early and steer.' },
  { step: '03', title: 'Launch', description: 'We go live with hosting, security, data migration and team onboarding handled, so launch day is uneventful.' },
  { step: '04', title: 'Grow & evolve', description: 'We watch how the product is used, measure what matters, and keep improving it as your business grows.' },
];
---

<Layout>
  <!-- ░░ HERO ░░ -->
  <section class="relative flex min-h-[90svh] items-center justify-center overflow-hidden pb-20 pt-28">
    <Background />
    <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center px-5 text-center">
      <div class="reveal">
        <SlotBadge />
      </div>

      <h1
        class="reveal mt-6 text-balance text-4xl font-medium leading-[1.05] tracking-tight text-foreground sm:text-5xl md:text-6xl"
        style="--reveal-delay: 80ms"
      >
        We build world-class<br class="hidden sm:block" /> products, end to end.
      </h1>

      <p
        class="reveal mt-6 max-w-2xl text-pretty text-base leading-relaxed text-muted-foreground md:text-lg"
        style="--reveal-delay: 160ms"
      >
        Autometa is a product studio. Consulting, design and engineering for web,
        mobile and desktop, agent-ready websites and AI, all under one roof, so your
        idea goes from first conversation to a product people rely on.
      </p>

      <div class="reveal mt-9 flex flex-col items-center gap-3 sm:flex-row" style="--reveal-delay: 240ms">
        <Button href="#contact" size="lg" iconRight="arrow-right" data-contact-modal>Start a project</Button>
        <Button href="#build" size="lg" variant="secondary">See what we build</Button>
      </div>
    </div>
  </section>

  <!-- ░░ WHAT WE BUILD ░░ -->
  <Section
    id="build"
    eyebrow="What we build"
    title="Whatever the product, on whatever platform"
    description="From the first strategy session to apps on the web, phone and desktop, we can take on the whole product or the part you need most."
  >
    <div class="mt-16 flex flex-col gap-20 md:gap-28">
      {buildAreas.map((a, i) => (
        <BuildRow area={a} index={i} />
      ))}
    </div>
  </Section>

  <!-- ░░ INDUSTRIES ░░ -->
  <Section
    id="industries"
    eyebrow="Industries"
    title="Industries we know from the inside"
    description="We have shipped products for these industries, so we already speak the language: the documents, the compliance, and the way the work really flows. New industry? We learn it properly before we build."
    class="bg-card-muted/20 border-y border-border"
  >
    <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
      {industries.map((ind, i) => (
        <div class="reveal flex flex-col gap-3 bg-card p-6" style={`--reveal-delay: ${i * 60}ms`}>
          <span class="inline-flex size-10 items-center justify-center rounded-lg border border-border bg-card-muted text-accent">
            <Icon name={ind.icon} size={20} />
          </span>
          <h3 class="text-base font-medium tracking-tight text-foreground">{ind.name}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{ind.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ░░ CAPABILITIES ░░ -->
  <Section
    id="capabilities"
    eyebrow="How we deliver"
    title="Everything it takes to build a great product"
    description="Most products stall in the gaps between strategy, design and development. We cover all of it with one team, so nothing gets lost along the way."
  >
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c, i) => (
        <CapabilityCard capability={c} index={i} />
      ))}
    </div>
  </Section>

  <!-- ░░ INTEGRATIONS ░░ -->
  <Integrations />

  <!-- ░░ WHY US ░░ -->
  <Section
    id="why"
    eyebrow="Why Autometa"
    title="A product partner, not just a dev shop."
    description="We care about the outcome, not only the code. That changes how we work at every step."
  >
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {differentiators.map((d, i) => (
        <FeatureCard icon={d.icon} title={d.name} description={d.description} index={i} />
      ))}
    </div>
  </Section>

  <!-- ░░ PROCESS / WORK ░░ -->
  <Section
    id="process"
    eyebrow="How we work"
    title="A clear path from idea to a product people use"
    description="No black boxes. You see progress early and own everything at the end."
  >
    <div class="mt-14 grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((p, i) => (
        <div class="reveal flex flex-col gap-3 bg-card p-7" style={`--reveal-delay: ${i * 70}ms`}>
          <span class="font-mono text-sm text-accent">{p.step}</span>
          <h3 class="text-lg font-medium tracking-tight text-foreground">{p.title}</h3>
          <p class="text-sm leading-relaxed text-muted-foreground">{p.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- ░░ FAQ ░░ -->
  <Section
    id="faq"
    eyebrow="FAQ"
    title="Questions, answered"
    description="The things people ask us most before getting started."
  >
    <Faq />
  </Section>

  <!-- ░░ CONTACT / CTA ░░ -->
  <section id="contact" class="relative overflow-hidden py-24 md:py-32">
    <div class="pointer-events-none absolute inset-0 grid-backdrop opacity-60"></div>
    <div class="relative mx-auto max-w-3xl container-px text-center">
      <div class="reveal"><ShinyBadge icon="rocket">Let's build</ShinyBadge></div>
      <h2 class="reveal mt-6 text-balance text-3xl font-medium tracking-tight text-foreground md:text-5xl" style="--reveal-delay: 80ms">
        Have a product in mind?
      </h2>
      <p class="reveal mx-auto mt-5 max-w-xl text-pretty text-base leading-relaxed text-muted-foreground md:text-lg" style="--reveal-delay: 140ms">
        Whether it is a rough idea, a product that needs rescuing, or a business
        that has outgrown its tools, tell us about it. We'll tell you what the
        first version should be and how we would build it.
      </p>
      <div class="reveal mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--reveal-delay: 200ms">
        <Button
          href={`https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}`}
          external
          size="lg"
          icon="whatsapp"
        >
          Schedule on WhatsApp
        </Button>
        <Button href={`mailto:${site.email}`} size="lg" variant="secondary" icon="mail">
          {site.email}
        </Button>
      </div>
      <p class="reveal mt-6 text-sm text-muted-foreground" style="--reveal-delay: 260ms">
        Already have something live? We can improve it in place or plan a controlled move to something better.
      </p>
    </div>
  </section>
</Layout>
